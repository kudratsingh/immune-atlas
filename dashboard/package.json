{
  "name": "immune-atlas-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fixture": "node scripts/use-fixture.mjs && next dev",
    "prepare:fixture": "node scripts/use-fixture.mjs",
    "gen:types": "json2ts -i ../contracts/dashboard-bundle.schema.json -o src/lib/bundle.types.ts --bannerComment \"/* Generated from contracts/dashboard-bundle.schema.json. Do not edit directly. */\"",
    "build": "npm run gen:types && next build",
    "start": "serve out -l 3000",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "@fontsource/ibm-plex-serif": "5.2.7",
    "@visx/axis": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "next": "16.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "postcss": "8.5.24",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "serve": "14.2.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
